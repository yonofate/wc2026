    }
    .ipu-num, .btn-input-bet {
        border-color: #285e8e;
    }
    .lb-link {
        padding-left: 10px;
        padding-right: 10px;
        color: #428bca;
        font-size:16px;
    }
    .f-16{
        font-size:16px;
    }
    .d-hide {
        display: none;
    }
    .entry-content {
        background-color: #fff;
        padding: 25px 30px;
        border-radius: 10px;
        padding-top:40px;
    }
    body.img1 {
        background-image: url('https://scontent.fsgn2-9.fna.fbcdn.net/v/t1.6435-9/201525533_4360907053962107_7452119942121115942_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=5f2048&_nc_eui2=AeEDefKAt8YA9xWIVCx0re90jwrYOVZQLCWPCtg5VlAsJWpP_JPyGkIwKamseGefuy4&_nc_ohc=RkYK14dEKckQ7kNvgHvC2Ye&_nc_ht=scontent.fsgn2-9.fna&oh=00_AYCcxLozVsfWhKsAZasRsopw_VTZwpmGcCxe5nJsNVXjgw&oe=6678306D');
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        background-position: center;
    }

    /* Hide the browser's default checkbox */
    .container-me {
        display: block;
        font-weight: normal;
        position: relative;
        padding-left: 26px;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

        .container-me input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            height: 0;
            width: 0;
        }

    /* Create a custom checkbox */
    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 22px;
        width: 22px;
        background-color: #fff;
        border: solid 2px #3276b1;
    }

    /* On mouse-over, add a grey background color */
    .container-me:hover input ~ .checkmark {
        background-color: #ccc;
    }

    /* When the checkbox is checked, add a blue background */
    .container-me input:checked ~ .checkmark {
        background-color: #3276b1;
    }

    /* Create the checkmark/indicator (hidden when not checked) */
    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
    }

    /* Show the checkmark when checked */
    .container-me input:checked ~ .checkmark:after {
        display: block;
    }

    /* Style the checkmark/indicator */
    .container-me .checkmark:after {
        left: 6px;
        top: 3px;
        width: 7px;
        height: 10px;
        border: solid white;
        border-width: 0 3px 3px 0;
        -webkit-transform: rotate(45deg);
        -ms-transform: rotate(45deg);
        transform: rotate(45deg);
    }

    .star-btn {
        font-size: 20px;
        line-height: 26px;      
    }

    .btn-rating {
        color: #afacac;
        cursor: pointer;
    }

        .btn-rating:hover, .btn-rating.checked {
            color: gold;
        }

        .btn-rating.disabled {
            cursor: auto;
        }

@@media only screen and (min-width: 768px) and (max-width: 1024px) {
    ul.nav.navbar-nav li:nth-child(1) {
        display: none;
    }
    @@media screen and (max-width: 600px) {
        .body-content {
            padding-left: 5px;
            padding-right: 5px;            
        }
        .entry-content {
            padding: 10px;
            border-radius: unset;
            padding-top: 25px;
        }
        .m-hide{
            display:none;
        }
        .d-hide{
            display:inline-block;
        }
        iframe{
            width:100% !important;
        }
        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        .table-container table {
            width: 100%;
            border-collapse: collapse;
        }
        .f-16 {
            font-size: 13px;
        }
}
    </style>
</head>
