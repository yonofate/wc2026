@{
    ViewBag.Title = "Dự đoán";
}

<style>
    .ipu-num {
        width: 46px;
        height: 46px;
        font-size: 22px;
        text-align: center;
        font-weight: bold;
    }
    
    .container-me {
        margin-bottom: 0;
    }
    .pre-board {
        width: 100%;
    }
        .pre-board.beted {
            background-color: #eef8f8;
        }
        .btn-sm {
            font-size: 13px;
        }
    .pre-board {
        margin: 0px auto;
    }
    .sup-k sup {
        top: -1.5em;
        left: 3px;
        font-size:85%;
    }
    .sup-k span {
        position:relative;
        left: -9px;
    }
        .pre-board tr:last-child {
            border-bottom: solid;
            border-width: 10px;
            border-color: rgb(247, 247, 249);
        }


    .link-detail {
        line-height: 28px;
    }
    .left .btn-rating {
        float: left;
        margin-left: 12px;
    }
    .right .btn-rating {
        float: right;
        margin-right: 12px;      
    }
    
    .right .link-detail.has-star {
        margin-right: -24px;
    }
    .left .link-detail.has-star {
        margin-left: -24px;
    }
    .f-16{
        font-size:18px;
    }
    .btn-input-bet {
        width:152px;
        font-size:16px;
    }
    .f-35{
        width:35%;
    }
    .f-14{
        width:14%;
    }
    @@media screen and (max-width: 600px) {
        .btn-sm, .sm-m {
            font-size: 12px;
        }
        .team-logo{
            width:50px;
        }
        .f-16 {
            font-size: 15px;
        }
        .f-35 {
            width: 39%;
        }

        .f-14 {
            width: 11%;
        }
        .ipu-num{
            width:36px;
            height:36px;
            font-size:18px;
        }
        .btn-input-bet {
            /*16 sua 110px*/
            width: 125px;
        }

        .left .btn-rating {
            float: left;
            margin-left: 5px;
        }

        .right .btn-rating {
            float: right;
            margin-right: 5px;
        }

        .right .link-detail.has-star {
            margin-right: -10px;
        }

        .left .link-detail.has-star {
            margin-left: -10px;
        }
    }
</style>
<table height=100% width=100%>    
    <tr>        
        <td align="center" valign="middle">
            @*<div class="panel panel-success table-container table-center">
                <div class="panel-heading" style="font-size: 25px; text-align: center">Dự đoán</div>
                <div class="panel-body">
                    <p style="margin:10px auto">
