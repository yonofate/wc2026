<script type="text/javascript">
    function clearPlaceholder(input) {
                    input.placeholder = '';
                }

                function restorePlaceholder(input) {
                    if (input.value === '') {
                        input.placeholder = '+';
                    }
                }

                function onSetScorePreditor(matchId) {
                    var homeGoal = $('#homeGoalPre').val();
                    var awayGoal = $('#awayGoalPre').val();
                    if (homeGoal == "" || awayGoal == "") {
                        alert("Bạn chưa chọn tỉ số!");
                        return;
                    }
        $.ajax({
                    type: "POST",
            url: '@Url.Action("SetScorePreditor", "Prediction")',
            dataType: "json",
            data: { matchId: matchId, homeGoal: homeGoal, awayGoal: awayGoal },
            success: function (data) {
                if (data == 1) {
                    toastr.success("Đã xác nhận tỉ số!");
                } else if (data == 2) {
                    toastr.success("Đã xác nhận tỉ số!");
                    alert('Hệ thống ghi nhận bạn đã chọn tỉ số ngược với đội theo, nếu muốn bạn có thể chọn lại!');
                }
                else if (data == 3) {
                    alert('Vòng loại trực tiếp sẽ không có tỉ số hòa, hãy chọn lại!')
                } else {
                                toastr.error("Thông tin cập nhật không hợp lệ!");
                            }
                        },
            error: errorFunc
        });
                }

                function changeScore(matchId,current, from) {
                    current.value = current.value.replace(/[^0-9]/g, '').slice(0, 1);
                    if (current.value.length === 1) {
                        var otherObj = from == 'home' ? $('#awayGoalPre') : $('#homeGoalPre');
                        var otherValue = otherObj.val();
                        if ((otherValue || '').length == 0) {
                            otherObj.focus();
                        } else {
                            onSetScorePreditor(matchId);
                        }
                    }
                }

                function onSetScore(matchId) {
                    var homeGoal = $('#homeGoal').val();
                    var awayGoal = $('#awayGoal').val();
        $.ajax({
                    type: "POST",
            url: '@Url.Action("SetScrore", "Prediction")',
            dataType: "json",
            data: { matchId: matchId, homeGoal: homeGoal, awayGoal: awayGoal },
            success: successFunc,
            error: errorFunc
        });
                }

                function onSetHandicap(matchId) {
                    var homeGoal = $('#homeGoal').val();
                    var awayGoal = $('#awayGoal').val();
        $.ajax({
                    type: "POST",
            url: '@Url.Action("SetHandicap", "Prediction")',
            dataType: "json",
            data: { matchId: matchId, homeHandicap: homeGoal, awayHandicap: awayGoal },
            success: successFunc,
            error: errorFunc
        });
                }

                function successFunc(data) {
                    if (data == 1) {
                        // toastr.success("Đã xác nhận dự đoán của bạn!");
                        window.location.reload(true);
                    }
                    else if (data == 2) {                       
                        alert('Hệ thống ghi nhận bạn đã chọn tỉ số ngược với đội theo, nếu muốn bạn có thể chọn lại!');
                        window.location.reload(true);
                    }
                    else {
                        //toastr.error("Trận đấu này đã hết thời hạn dự đoán!");
                        alert('Trận đấu này đã hết thời hạn dự đoán');
                    }

                }

                function errorFunc() {
                    //toastr.error("Đã có lỗi xảy ra, vui lòng liên hệ quản trị!");
                    alert('Trận đấu này đã hết thời hạn dự đoán!');
                }

                function onPredictHome(matchId) {
                    onPredict(matchId, 1);
                }

                function onPredictAway(matchId) {
                    onPredict(matchId, 2);
                }

                function onChooseStar_Check(matchId) {
                    if (($("#is_beted").val() || '') == '') {
                        alert('Chọn đội thắng trước!');
                    $('#ckIsChooseStar').prop('checked', false);
                        return;
                    }
                    var t = $('#ckIsChooseStar').hasClass('checked') == true ? 3 : 1;
                    onHope(matchId, t);
                }

                function onChooseStar(matchId) {
                    onHope(matchId, 1);
                }

                function onChooseDollar(matchId) {
                    onHope(matchId, 2);
                }

                function onNotChoose(matchId) {
                    onHope(matchId, 3);
                }

                function onHope(matchId, type) {
                    var res = true;
                    if (type == 1) res = confirm("Xác nhận đặt ngôi sao hy vọng! ");
                    if (res == false) $('#ckIsChooseStar').removeClass('checked');
                    else {
            $.ajax({
                        type: "POST",
                url: '@Url.Action("Hope", "Prediction")',
                dataType: "json",
                data: { matchId: matchId, type: type },
                success: function (res) {
                    if (res.code == 0) {
                        $('#ckIsChooseStar').removeClass('checked');
                        if (res.msg) alert(res.msg);
                    } else {
                        if (type == 1) $('#ckIsChooseStar').addClass('checked');
                        else $('#ckIsChooseStar').removeClass('checked');
                    }
                                window.location.reload(true);
                            },
                error: errorFunc
            });
                    }
                }

                function onPredict(matchId, type) {
        $.ajax({
                    type: "POST",
            url: '@Url.Action("Predict", "Prediction")',
            dataType: "json",
            data: { matchId: matchId, type: type },
            success: successFunc,
            error: errorFunc
        });
                }
</script>