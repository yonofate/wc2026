    }

    @@media screen and (max-width: 600px) {
        .logo-team {
            width: 48px;
        }
        .btn-sm {
            font-size: 14px;
        }
        .btn-input-bet {
            width: 100%;
        }
        table.match-detail th:first-child,
        table.match-detail td:first-child {
            display: none;
        }
        .sm-text{
            font-size:12px;
        }
        .lb-link{
